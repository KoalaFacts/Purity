{
  "name": "@purityjs/router",
  "version": "0.5.0",
  "description": "Routing and navigation for Purity",
  "license": "Apache-2.0",
  "author": "KoalaFacts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoalaFacts/Purity.git",
    "directory": "packages/router"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "purity-server": {
        "development": {
          "node": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
          },
          "default": "./src/index.ts"
        },
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "development": {
        "node": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "require": "./dist/index.cjs"
        },
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/browser/index.js",
        "require": "./dist/browser/index.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && vp build -c vite.browser.config.ts && tsc --emitDeclarationOnly",
    "test": "vp test run"
  },
  "dependencies": {
    "@purityjs/signals": "^0.5.0"
  },
  "peerDependencies": {
    "@purityjs/core": "^0.5.0"
  }
}
