{
  "name": "purity-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--conditions=development vp dev",
    "build": "cross-env NODE_OPTIONS=--conditions=development vp build",
    "preview": "cross-env NODE_OPTIONS=--conditions=development vp preview",
    "profile": "node --conditions=development tools/profile.ts",
    "analyze": "node tools/analyze.ts",
    "compare": "node --conditions=development tools/compare.ts",
    "sanity": "node --conditions=development tools/sanity.ts",
    "a11y": "node --conditions=development tools/a11y.ts",
    "a11y:form": "node --conditions=development tools/a11y-form-check.ts",
    "a11y:matrix": "node --conditions=development tools/a11y-matrix.ts"
  },
  "dependencies": {
    "@purityjs/core": "*",
    "@purityjs/vite-plugin": "*",
    "@solidjs/vite-plugin": "3.0.0-next.48",
    "@solidjs/web": "2.0.0-rc.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solid-js": "2.0.0-rc.14",
    "svelte": "^5.57.1",
    "vue": "3.6.0-rc.10"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "^1.60.0",
    "tsx": "^4.23.15",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
