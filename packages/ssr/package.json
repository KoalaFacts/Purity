{
  "name": "@purityjs/ssr",
  "version": "0.5.0",
  "description": "Server-side rendering for Purity — renderToString + SSR html`` tag",
  "keywords": [
    "declarative-shadow-dom",
    "hydration",
    "purity",
    "server-side-rendering",
    "ssr"
  ],
  "license": "Apache-2.0",
  "author": "KoalaFacts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoalaFacts/Purity.git",
    "directory": "packages/ssr"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./runtime": {
      "development": {
        "node": {
          "types": "./dist/runtime.d.ts",
          "import": "./dist/runtime.js",
          "require": "./dist/runtime.cjs"
        },
        "default": "./src/runtime.ts"
      },
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    ".": {
      "development": {
        "node": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "require": "./dist/index.cjs"
        },
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly",
    "test": "vp test run"
  },
  "dependencies": {
    "@purityjs/compiler": "^0.5.0",
    "@purityjs/signals": "^0.5.0"
  },
  "peerDependencies": {
    "@purityjs/core": "^0.5.0"
  }
}
