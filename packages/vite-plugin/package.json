{
  "name": "@purityjs/vite-plugin",
  "version": "0.5.0",
  "description": "Vite plugin for AOT template compilation in Purity",
  "keywords": [
    "aot",
    "compiler",
    "plugin",
    "purity",
    "vite"
  ],
  "license": "Apache-2.0",
  "author": "KoalaFacts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoalaFacts/Purity.git",
    "directory": "packages/vite-plugin"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "node": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "require": "./dist/index.cjs"
        },
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && tsc --emitDeclarationOnly",
    "test": "vp test run",
    "test:browser:devtools": "node --experimental-strip-types tests/devtools-browser.ts"
  },
  "dependencies": {
    "@purityjs/compiler": "0.5.0",
    "@purityjs/router": "0.5.0",
    "oxc-parser": "0.154.0"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "peerDependencies": {
    "@purityjs/core": "^0.5.0",
    "vite": ">=6.0.0"
  }
}
